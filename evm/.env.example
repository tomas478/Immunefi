# Copy to evm/.env (gitignored) — never commit secrets or paid RPC keys.

# Ethereum mainnet (Origin, DeFi Saver forks)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional L2 / alt chains (Lista on BSC, Origin on Base/Arbitrum)
BASE_RPC_URL=
ARBITRUM_RPC_URL=
BSC_RPC_URL=

# Block explorer keys (optional, for cast verify / traces)
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=

# Pin fork tests: set in test file or export before `forge test`
# FORK_BLOCK_NUMBER=21000000